"use client";
import { motion } from "framer-motion";
import { EXPERIENCE } from "../lib/constants";

export default function ExperienceNew() {
  return (
    <section id="experience" className="py-24 lg:py-32">
      <div className="max-w-5xl mx-auto px-6 sm:px-10">
        <div className="flex items-center gap-3 mb-12"><div className="w-12 h-px bg-gradient-to-r from-[#00FF66] to-transparent"/><span className="font-mono text-xs text-[#00FF66] uppercase tracking-[0.3em]">Timeline</span></div>
        <h2 className="text-4xl sm:text-5xl font-mono font-bold text-[#F5F7F7] tracking-tight mb-12">WORK HISTORY</h2>
        <div className="relative pl-8 border-l border-[#00FF66]/20">
          {EXPERIENCE.map((e,i) => (
            <motion.div key={e.id} initial={{opacity:0,x:-10}} animate={{opacity:1,x:0}} transition={{delay:i*0.15}} className="relative mb-10 pl-8">
              <span className="absolute -left-[9px] top-1.5 w-4 h-4 rounded-full bg-[#00FF66] border-2 border-[#030507] shadow-[0_0_10px_#00FF66]" />
              <div className="rounded-xl p-6 bg-[#0B1713]/60 border border-[#00FF66]/10 hover:border-[#00FF66]/30 transition-all">
                <div className="flex flex-wrap gap-2 mb-2"><span className="px-3 py-0.5 text-xs font-mono bg-[#00FF66]/10 text-[#00FF66] rounded">{e.duration}</span><span className="text-sm font-mono text-[#F5F7F7]">{e.company}</span></div>
                <h3 className="text-xl font-mono font-bold text-[#F5F7F7] mb-1">{e.role}</h3>
                <p className="text-sm text-[#A7B0B0] mb-3">{e.description}</p>
                <div className="flex flex-wrap gap-2">{e.techStack.map(t=><span key={t} className="text-xs font-mono px-2 py-0.5 rounded bg-white/5 border border-white/10 text-[#A7B0B0]">{t}</span>)}</div>
              </div>
            </motion.div>
          ))}
        </div>
      </div>
    </section>
  );
}