"use client";

import { useEffect, useRef } from "react";
import { useReducedMotion } from "framer-motion";
import { useFxLevel } from "../lib/fx";
import * as THREE from "three";

// Video-inspired living particle field.
//
// The reference animation is a dark, synthetic ecosystem: thousands of low-mass
// points drifting in a tight volume around a translucent central hub, connected
// by thin cyan/green traces that only appear between nearby particles. The
// field breathes, flows toward the cursor, and the hub pulses. Everything is
// deliberately calm — no rainbow colours, no giant glowing blobs, no bloom.
//
// Design tokens (from the brief):
//   background #030507 / #050806 / #07100D
//   neon green  #00FF66
//   cyan        #00E5FF
//   optional blue #3B82F6
const BACKGROUND = new THREE.Color(0x030507);

const NODE_GREEN = new THREE.Color(0x00ff66);
const NODE_CYAN = new THREE.Color(0x00e5ff);
const NODE_BLUE = new THREE.Color(0x3b82f6);

export default function CursorReactiveBg() {
  const fx = useFxLevel();
  // Same media query MotionConfig reducedMotion="user" reads — no parallel
  // preference logic. When true we render one fully-composed static frame.
  const reduce = useReducedMotion();
  const containerRef = useRef<HTMLDivElement>(null);
  const sceneRef = useRef<any>(null);
  const cameraRef = useRef<any>(null);
  const rendererRef = useRef<any>(null);
  const particlesRef = useRef<any>(null);
  const hubRef = useRef<any>(null);
  const connectorRef = useRef<any>(null);
  const particleCountRef = useRef(0);
  const clockRef = useRef<any>(new THREE.Clock());
  const mouseRef = useRef<{ x: number; y: number; active: boolean }>({
    x: 0,
    y: 0,
    active: false,
  });
  const prevMouseRef = useRef<{ x: number; y: number; active: boolean }>({
    x: 0,
    y: 0,
    active: false,
  });

  // Build the field once. We never allocate inside the animation loop.
  useEffect(() => {
    const container = containerRef.current;
    if (!container) return;

    const scene = new THREE.Scene();
    scene.background = BACKGROUND;

    const camera = new THREE.PerspectiveCamera(
      60,
      container.clientWidth / container.clientHeight,
      0.1,
      1000
    );
    camera.position.z = 60;

    const renderer = new THREE.WebGLRenderer({
      antialias: true,
      alpha: true,
      powerPreference: "high-performance",
    });
    renderer.setSize(container.clientWidth, container.clientHeight);
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    renderer.setClearColor(BACKGROUND, 0);
    renderer.outputColorSpace = THREE.SRGBColorSpace;
    container.appendChild(renderer.domElement);

    // Hide the canvas from search/indexers while keeping it focusable-free.
    renderer.domElement.setAttribute("aria-hidden", "true");
    renderer.domElement.style.cssText =
      "display:block;position:absolute;inset:0;width:100%;height:100%;pointer-events:none;z-index:0;";

    // ---- Resting particle positions (reused on every frame, not allocated) ----
    const count = 850;
    const pos = new Float32Array(count * 3);
    const home = new Float32Array(count * 3);
    let i = 0;
    while (i < count) {
      const t = i / count;
      const radius = 6 + t * 58; // tight core -> reachable edge
      const angle = t * Math.PI * 4.5;
      const x = Math.cos(angle) * radius * (0.35 + Math.random() * 0.65);
      const y = Math.sin(angle * 0.7 + 1.2) * radius * (0.35 + Math.random() * 0.65);
      const z = (Math.random() - 0.5) * 22;
      pos[i * 3] = x;
      pos[i * 3 + 1] = y;
      pos[i * 3 + 2] = z;
      home[i * 3] = x;
      home[i * 3 + 1] = y;
      home[i * 3 + 2] = z;
      i++;
    }

    // ---- BufferGeometry: position ----
    const geometry = new THREE.BufferGeometry();
    geometry.setAttribute(
      "position",
      new THREE.BufferAttribute(pos, 3) as any
    );

    // ---- BufferGeometry: colour ----
    const colour = new Float32Array(count * 3);
    for (let k = 0; k < count; k++) {
      const c = new THREE.Color(0x00ff66);
      colour[k * 3] = c.r;
      colour[k * 3 + 1] = c.g;
      colour[k * 3 + 2] = c.b;
    }
    geometry.setAttribute(
      "color",
      new THREE.BufferAttribute(colour, 3) as any
    );

    const material = new THREE.PointsMaterial({
      size: 0.7,
      vertexColors: true,
      transparent: true,
      opacity: 0.85,
      blending: THREE.AdditiveBlending,
      depthWrite: false,
      sizeAttenuation: true,
    });
    const particles = new THREE.Points(geometry, material) as any;
    scene.add(particles);

    // ---- Central hub (the "living AI core") ----
    const hubGeometry = new THREE.SphereGeometry(1.4, 16, 16);
    const hubMaterial = new THREE.MeshBasicMaterial({
      color: 0x00e5ff,
      transparent: true,
      opacity: 0.85,
      depthWrite: false,
    });
    const hub = new THREE.Mesh(hubGeometry, hubMaterial) as any;
    hub.position.set(0, 0, 0);
    scene.add(hub);

    // ---- Connections: thin lines between neighbours + hub ----
    const neighborCount = 18;
    const connectorIndices: number[] = [];
    const connectorDist = new Float32Array(neighborCount);
    for (let k = 0; k < neighborCount; k++) {
      connectorIndices.push(k, (k + 1) % neighborCount);
      connectorDist[k] = 8 + Math.random() * 14;
    }
    connectorIndices.push(neighborCount, 0); // hub <-> nearest particle

    const connectorMaterial = new THREE.LineBasicMaterial({
      color: 0x00e5ff,
      transparent: true,
      opacity: 0.18,
      depthWrite: false,
    });
    const connector = new THREE.Line(
      new THREE.BufferGeometry(),
      connectorMaterial
    ) as any;
    connectorRef.current = connector;
    scene.add(connector);

    // Pre-allocate per-frame buffers (reused, not allocated).
    const linkPositions = new Float32Array((neighborCount + 1) * 3 * 3);
    const linkGeometry = new THREE.BufferGeometry();
    linkGeometry.setAttribute(
      "position",
      new THREE.BufferAttribute(linkPositions, 3) as any
    );
    linkGeometry.index = null;

    scene.fog = new THREE.FogExp2(BACKGROUND, 0.018);

    particleCountRef.current = count;
    sceneRef.current = scene;
    cameraRef.current = camera;
    rendererRef.current = renderer;
    particlesRef.current = particles;
    hubRef.current = hub;

    // ---- Cursor tracking (subtle, spring-free but damped) ----
    const onMove = (e: MouseEvent) => {
      const r = container.getBoundingClientRect();
      mouseRef.current.x = ((e.clientX - r.left) / r.width) * 2 - 1;
      mouseRef.current.y = -((e.clientY - r.top) / r.height) * 2 + 1;
      mouseRef.current.active = true;
    };
    const onTouch = (e: TouchEvent) => {
      if (e.touches.length === 1) {
        const t = e.touches[0];
        const r = container.getBoundingClientRect();
        mouseRef.current.x = ((t.clientX - r.left) / r.width) * 2 - 1;
        mouseRef.current.y = -((t.clientY - r.top) / r.height) * 2 + 1;
        mouseRef.current.active = true;
      }
    };
    const onLeave = () => {
      mouseRef.current.active = false;
    };

    if (!reduce) {
      window.addEventListener("mousemove", onMove, { passive: true });
      window.addEventListener("touchmove", onTouch, { passive: true });
      window.addEventListener("touchstart", onTouch, { passive: true });
      window.addEventListener("mouseleave", onLeave, { passive: true });
    }
    const onResize = () => {
      const w = container.clientWidth;
      const h = container.clientHeight;
      if (!camera || !renderer) return;
      camera.aspect = w / h;
      camera.updateProjectionMatrix();
      renderer.setSize(w, h);
      renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
      // No rAF loop to repaint after a resize — recompose the static frame.
      if (reduce) step(0);
    };

    window.addEventListener("resize", onResize);

    // ---- Animation loop (single rAF, no per-frame allocations) ----
    let frame = 0;
    let hidden = false;
    const onHidden = () => { hidden = document.hidden; };
    document.addEventListener("visibilitychange", onHidden, { passive: true });
    const step = (d: number) => {

      const m = mouseRef.current;
      prevMouseRef.current.x += (m.x - prevMouseRef.current.x) * 0.12;
      prevMouseRef.current.y += (m.y - prevMouseRef.current.y) * 0.12;
      prevMouseRef.current.active &&= m.active;

      const pAttr = particles.geometry.attributes.position as any;
      const cAttr = particles.geometry.attributes.color as any;
      const p = pAttr.array as Float32Array;
      const c = cAttr.array as Float32Array;
      const pc = particleCountRef.current;
      const hub = hubRef.current;
      const initialCursor = prevMouseRef.current;
      const isActive = initialCursor.active;

      let minDist = Infinity;
      let nearestIdx = 0;
      const baseGreen = 0.35 + Math.sin(frame * 0.015) * 0.1;
      const cursorX = initialCursor.x;
      const cursorY = initialCursor.y;

      // Single consolidated high-performance pass over all particles (replaces 5 separate loops and Math.random overhead)
      for (let k = 0; k < pc; k++) {
        const k3 = k * 3;
        const x = p[k3];
        const y = p[k3 + 1];
        const z = p[k3 + 2];
        const hx = home[k3];
        const hy = home[k3 + 1];
        const hz = home[k3 + 2];

        // Damping towards home + smooth deterministic float
        const rx = hx + (x - hx) * 0.96;
        const ry = hy + (y - hy) * 0.96;
        const rz = hz + (z - hz) * 0.96;

        const vx = rx - hx;
        const vy = ry - hy;
        const vz = rz - hz;
        const drift = Math.sin(frame * 0.04 + k) * 0.003 * (d === 0 ? 0 : d * 60);

        let nx = rx + vx * 0.02 * (d === 0 ? 0 : d * 60) + drift;
        let ny = ry + vy * 0.02 * (d === 0 ? 0 : d * 60) + drift;
        let nz = rz + vz * 0.02 * (d === 0 ? 0 : d * 60) + drift;

        // Distance to cursor
        const dx = nx - cursorX;
        const dy = ny - cursorY;
        const dz = nz;
        const distSq = dx * dx + dy * dy + dz * dz;

        if (distSq < minDist) {
          minDist = distSq;
          nearestIdx = k;
        }

        // Repel from cursor if active and near
        if (isActive && d > 0) {
          const dist = Math.sqrt(distSq);
          if (dist < 14 && dist > 0.01) {
            const force = (1 - dist / 14) / dist;
            nx += dx * force * d * 40;
            ny += dy * force * d * 40;
          }
        }

        // Constrain into volume limit (46)
        const lenSq = nx * nx + ny * ny + nz * nz;
        const limit = 46;
        if (lenSq > limit * limit) {
          const len = Math.sqrt(lenSq);
          const scale = limit / len;
          nx *= scale;
          ny *= scale;
          nz *= scale;
        }

        p[k3] = nx;
        p[k3 + 1] = ny;
        p[k3 + 2] = nz;

        // Colour shift: green close to cursor, cyan in the field
        const cdist = Math.sqrt(dx * dx + dy * dy);
        const near = Math.max(0, 1 - cdist / 14);
        c[k3] = baseGreen + near * 0.65;
        c[k3 + 1] = 0.7 + near * 0.3;
        c[k3 + 2] = 1;
      }

      pAttr.needsUpdate = true;
      cAttr.needsUpdate = true;
      minDist = Math.sqrt(minDist);

      // Pulse the hub on a slow rhythm (no new objects per frame).
      if (hub) {
        const pulse = 0.85 + Math.sin(frame * 0.025) * 0.15;
        hub.scale.setScalar(1.4 + pulse * 0.6);
        hubMaterial.opacity = 0.7 + pulse * 0.3;
      }

      // Recompute connector positions from the same Float32Array (no allocation).
      const lp = linkPositions;
      for (let k = 0; k < neighborCount; k++) {
        const a = k * 3;
        const b = ((k + 1) % neighborCount) * 3;
        const ax = p[a],
          ay = p[a + 1],
          az = p[a + 2];
        const bx = p[b],
          by = p[b + 1],
          bz = p[b + 2];
        const d_line = connectorDist[k];
        const mx = (ax + bx) / 2,
          my = (ay + by) / 2,
          mz = (az + bz) / 2;
        const len = Math.sqrt(
          (bx - ax) * (bx - ax) + (by - ay) * (by - ay) + (bz - az) * (bz - az)
        );
        const ux = len > 0.001 ? (bx - ax) / len : 0;
        const uy = len > 0.001 ? (by - ay) / len : 0;
        const uz = len > 0.001 ? (bz - az) / len : 0;
        const off = d_line * 0.5;
        lp[k * 3] = mx + ux * off;
        lp[k * 3 + 1] = my + uy * off;
        lp[k * 3 + 2] = mz + uz * off;
        const n = ((k + 1) % neighborCount) * 3;
        lp[k * 3 + 3] = p[n];
        lp[k * 3 + 4] = p[n + 1];
        lp[k * 3 + 5] = p[n + 2];
      }
      // hub <-> nearest particle
      const n = nearestIdx * 3;
      const sx = p[n],
        sy = p[n + 1],
        sz = p[n + 2];
      const hx = 0,
        hy = 0,
        hz = 0;
      const len = Math.sqrt(
        (sx - hx) * (sx - hx) + (sy - hy) * (sy - hy) + (sz - hz) * (sz - hz)
      );
      const ux = len > 0.001 ? (sx - hx) / len : 0;
      const uy = len > 0.001 ? (sy - hy) / len : 0;
      const uz = len > 0.001 ? (sz - hz) / len : 0;
      const off = 5;
      lp[neighborCount * 3] = hx + ux * off;
      lp[neighborCount * 3 + 1] = hy + uy * off;
      lp[neighborCount * 3 + 2] = hz + uz * off;
      lp[neighborCount * 3 + 3] = sx;
      lp[neighborCount * 3 + 4] = sy;
      lp[neighborCount * 3 + 5] = sz;

      linkGeometry.attributes.position!.needsUpdate = true;
      connectorRef.current.geometry = linkGeometry;
      connectorRef.current.material.opacity = 0.10 + (1 - Math.min(minDist, 196) / 196) * 0.2;
      if (hub && connectorRef.current && connectorRef.current.material && connectorRef.current.material.color) {
        connectorRef.current.material.color.setHex(0x00e5ff);
      }
      connectorRef.current.visible = true;

      renderer.render(scene, camera);
    };
    const animate = () => {
      frame = requestAnimationFrame(animate);
      if (hidden) return;
      step(clockRef.current.getDelta());
    };
    if (reduce) {
      // Reduced motion: one composed frame at rest positions — same particle
      // design, hub and connectors, with the radial colour gradient intact
      // (d = 0 freezes drift/repel; no loop, no cursor tracking).
      step(0);
    } else {
      animate();
    }

    return () => {
      window.cancelAnimationFrame(frame);
      document.removeEventListener("visibilitychange", onHidden);
      window.removeEventListener("mousemove", onMove);
      window.removeEventListener("touchmove", onTouch);
      window.removeEventListener("touchstart", onTouch);
      window.removeEventListener("mouseleave", onLeave);
      window.removeEventListener("resize", onResize);
      scene.clear();
      sceneRef.current = null;
      cameraRef.current = null;
      rendererRef.current = null;
    };
  }, [reduce]);

  useEffect(() => {
    const renderer = rendererRef.current;
    const container = containerRef.current;
    if (!renderer || !container) return;
    if (fx === "off") {
      container.innerHTML = "";
      renderer.dispose();
      sceneRef.current = null;
      cameraRef.current = null;
      rendererRef.current = null;
    }
  }, [fx]);

  if (fx === "off") return null;

  return (
    <div
      ref={containerRef}
      aria-hidden="true"
      className="pointer-events-none fixed inset-0 z-0 overflow-hidden"
    />
  );
}
